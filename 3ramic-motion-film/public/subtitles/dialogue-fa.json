      "speaker": "tile",
      "from": 3,
      "to": 54,
      "text": "من دیگه اینجا کار نمی‌کنم!"
    },
    {
      "id": 2,
      "line": "L02",
      "speaker": "detective",
      "from": 55,
      "to": 77,
      "text": "چرا؟!"
    },
    {
      "id": 3,
      "line": "L03",
      "speaker": "tile",
      "from": 77,
      "to": 125,
      "text": "آخه این چه ترکیبیه؟!"
    },
    {
      "id": 4,
      "line": "L04",
      "speaker": "detective",
      "from": 127,
      "to": 192,
      "text": "خب… پرونده باز شد."
    },
    {
      "id": 5,
      "line": "L05",
      "speaker": "pattern",
      "from": 206,
      "to": 256,
      "text": "من فقط می‌خواستم دیده بشم!"
    },
    {
      "id": 6,
      "line": "L06",
      "speaker": "detective",
      "from": 256,
      "to": 304,
      "text": "خب، زیادی دیده شدی!"
    },
    {
      "id": 7,
      "line": "L07",
      "speaker": "detective",
      "from": 308,
      "to": 381,
      "text": "شیش متر جا… هزار تیکه؟!"
    },
    {
      "id": 8,
      "line": "L08",
      "speaker": "vanity",
      "from": 385,
      "to": 463,
      "text": "این‌جا بدون من هیچی نیست!"
    },
    {
      "id": 9,
      "line": "L09",
      "speaker": "detective",
      "from": 468,
      "to": 533,
      "text": "با تو هم که… جایی نمونده!"
    },
    {
      "id": 10,
      "line": "L10",
      "speaker": "detective",
      "from": 543,
      "to": 593,
      "text": "متراژ که عوض نمی‌شه…"
    },
    {
      "id": 11,
      "line": "L10",
      "speaker": "detective",
      "from": 595,
      "to": 663,
      "text": "انتخاب‌ها باید با هم جور باشن."
    },
    {
      "id": 12,
      "line": "L11",
      "speaker": "detective",
      "from": 663,
      "to": 698,
      "text": "کارِ 3ramicه!"
    },
    {
      "id": 13,
      "line": "L12",
      "speaker": "pattern",
      "from": 803,
      "to": 839,
      "text": "این‌جا جای منه!"
    },
    {
      "id": 14,
      "line": "L13",
      "speaker": "tile",
      "from": 884,
      "to": 955,
      "text": "اوه… این دیگه یه چیز دیگه‌س!"
    },
    {
      "id": 15,
      "line": "L14",
      "speaker": "detective",
      "from": 956,
      "to": 1014,
      "text": "خب، استعفاتو پس می‌گیری؟"
