      "text": "من دیگه اینجا کار نمی‌کنم!"
    },
    {
      "id": 2,
      "line": "L02",
      "speaker": "detective",
      "from": 54,
      "to": 73,
      "text": "چرا؟!"
    },
    {
      "id": 3,
      "line": "L03",
      "speaker": "tile",
      "from": 73,
      "to": 118,
      "text": "آخه این چه ترکیبیه؟!"
    },
    {
      "id": 4,
      "line": "L04",
      "speaker": "detective",
      "from": 120,
      "to": 180,
      "text": "خب… پرونده باز شد."
    },
    {
      "id": 5,
      "line": "L05",
      "speaker": "pattern",
      "from": 194,
      "to": 242,
      "text": "من فقط می‌خواستم دیده بشم!"
    },
    {
      "id": 6,
      "line": "L06",
      "speaker": "detective",
      "from": 242,
      "to": 295,
      "text": "خب، زیادی دیده شدی!"
    },
    {
      "id": 7,
      "line": "L07",
      "speaker": "detective",
      "from": 300,
      "to": 379,
      "text": "شیش متر جا… هزار تیکه؟!"
    },
    {
      "id": 8,
      "line": "L08",
      "speaker": "vanity",
      "from": 383,
      "to": 455,
      "text": "اینجا بدون من هیچی نیست!"
    },
    {
      "id": 9,
      "line": "L09",
      "speaker": "detective",
      "from": 460,
      "to": 525,
      "text": "با تو هم که… جایی نمونده!"
    },
    {
      "id": 10,
      "line": "L10",
      "speaker": "detective",
      "from": 535,
      "to": 589,
      "text": "متراژ که عوض نمی‌شه…"
    },
    {
      "id": 11,
      "line": "L10",
      "speaker": "detective",
      "from": 589,
      "to": 655,
      "text": "انتخابا باید با هم جور باشن."
    },
    {
      "id": 12,
      "line": "L11",
      "speaker": "detective",
      "from": 655,
      "to": 715,
      "text": "باید بریم سراغِ 3ramic!"
