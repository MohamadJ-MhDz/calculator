{
  "name": "3ramic-motion-film",
  "version": "1.0.0",
  "description": "«پروندهٔ استعفای سرامیک‌ها» — The Tiles That Quit: a 1080×1920 Persian-language 3D Instagram Reel for 3ramic (Remotion + React Three Fiber)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/three": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "@types/three": "0.170.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "studio": "remotion studio",
    "dev": "remotion studio",
    "validate": "node scripts/validate.mjs",
    "render": "node scripts/render.mjs",
    "render:preview": "node scripts/render.mjs --scale 0.5",
    "render:direct": "remotion render ThreeRamicFilm out/3ramic-reel-1080x1920.mp4 --codec=h264 --crf=18",
    "stills": "remotion render QAFrames out/qa/frames --sequence --image-format=jpeg --jpeg-quality=90 && node scripts/py.mjs scripts/qa/contact_sheet.py",
    "cover": "remotion still Cover out/instagram/cover-1080x1920.jpg --image-format=jpeg --jpeg-quality=95",
    "timeline": "node scripts/py.mjs scripts/audio/build_timeline.py && node scripts/audio/export_cues.mjs && node scripts/py.mjs scripts/audio/write_direction.py",
    "audio": "node scripts/audio/export_cues.mjs && node scripts/py.mjs scripts/audio/build_audio.py",
    "voices:setup": "node scripts/py.mjs scripts/audio/voice_synthesize.py --setup",
    "voices": "node scripts/py.mjs scripts/audio/voice_synthesize.py --takes 6",
    "voices:select": "node scripts/py.mjs scripts/audio/voice_select.py",
    "fonts": "node scripts/vendor-fonts.mjs",
    "lint": "eslint src && tsc",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade"
  },
  "allowScripts": {
    "esbuild": false
  }
}
